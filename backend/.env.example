# Copie este arquivo para .env e preencha os valores
USE_POSTGRES=False // Defina como True para usar PostgreSQL, ou False para usar SQLite
SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DEBUG=True
DB_NAME=inframind_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432
GEMINI_API_KEY=sua_chave_gemini_aqui


# Tempo máximo de espera por resposta do Gemini, em segundos (padrão: 5)
# GEMINI_TIMEOUT_SECONDS=5

# ── E-mail (UC-14 e recuperação de senha) ─────────────────────
# Sem EMAIL_HOST o envio é só simulado no console. Exemplo com Gmail:
# use uma "senha de app" (Conta Google > Segurança > Senhas de app), não a senha normal.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu_email@gmail.com
# EMAIL_HOST_PASSWORD=sua_senha_de_app
# DEFAULT_FROM_EMAIL=InfraMind <seu_email@gmail.com>

# Página que abre pelo link do e-mail de recuperação de senha.
# FRONTEND_URL=http://127.0.0.1:5500/frontend/index.html

